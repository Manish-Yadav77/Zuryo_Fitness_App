# Server Configuration
NODE_ENV=development
PORT=5000

# Database Connection (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/zuryo?retryWrites=true&w=majority

# Authentication Security (JWT)
JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters
JWT_EXPIRES_IN_SECONDS=43200

# CORS Security
CLIENT_ORIGIN=http://localhost:5173

# Seed Script Credentials
SEED_PASSWORD=Demo@12345

# Razorpay Payment Gateway (Test Mode)
RAZORPAY_KEY_ID=rzp_test_dummy_key
RAZORPAY_KEY_SECRET=dummy_secret

# AI Recommendation Model (For Phase 8 preview)
LLM_API_KEY=your_gemini_or_llm_api_key_here
LLM_MODEL=gemini-2.5-flash